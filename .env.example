# =============================================================
#  VARIÁVEIS DE AMBIENTE
# =============================================================
#  A landing page de HOJE não precisa de nenhuma variável aqui:
#  todas as configurações visíveis ficam em src/config/site.ts.
#
#  Este arquivo é só um mapa do que vamos usar nas PRÓXIMAS fases
#  (login/banco com Supabase, área de membros e webhook da Kiwify).
#  Copie para ".env.local" quando chegar a hora. NUNCA comite segredos.
# =============================================================

# --- Supabase (fase 2: login e banco) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # só no servidor, nunca exponha no cliente

# --- Kiwify (fase 3: webhook que libera o acesso de quem pagou) ---
# KIWIFY_WEBHOOK_SECRET=       # segredo pra validar a assinatura do webhook
