# =============================================================
#  VARIÁVEIS DE AMBIENTE DO ZUKE
# =============================================================
#  Local:  copie este arquivo para ".env.local" e preencha.
#  Vercel: cadastre as MESMAS variáveis em
#          Project → Settings → Environment Variables.
#
#  NUNCA comite o .env.local (ele já está no .gitignore).
#  A landing page funciona sem nada disto; a plataforma precisa.
# =============================================================


# --- Supabase -------------------------------------------------
# Painel do Supabase → Project Settings → API (ou "API Keys").

# URL do projeto. Ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave PÚBLICA. Aparece como "anon public" (formato antigo, começa com eyJ...)
# ou "publishable" (formato novo, começa com sb_publishable_...). Qualquer uma serve.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA. Aparece como "service_role" (eyJ...) ou "secret" (sb_secret_...).
# ⚠️ Dá acesso total ao banco. Fica SÓ no servidor: nunca coloque o prefixo
# NEXT_PUBLIC_ nela e nunca cole em lugar público.
SUPABASE_SERVICE_ROLE_KEY=


# --- Site -----------------------------------------------------
# Endereço do site, sem barra no final. Usado nos links dos e-mails.
# Local: http://localhost:3000   |   Produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Kiwify ---------------------------------------------------
# O "Token" que aparece quando você cria o webhook na Kiwify
# (Apps → Webhooks). É ele que valida que o aviso veio mesmo da Kiwify.
KIWIFY_WEBHOOK_TOKEN=

# (Opcional) ID do produto do Zuke na Kiwify. Se preenchido, webhooks de
# outros produtos da sua conta são ignorados. Deixe vazio se só vende o Zuke.
KIWIFY_PRODUCT_ID=

# Dias que a pessoa continua com acesso com o pagamento atrasado. Padrão: 3.
LATE_GRACE_DAYS=3


# --- Admin ----------------------------------------------------
# E-mails que podem abrir o /admin, separados por vírgula.
# Ex.: voce@gmail.com,socio@gmail.com
ADMIN_EMAILS=
